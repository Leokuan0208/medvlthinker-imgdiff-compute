# Third-party repos (cloned upstream, not our code)
MedRAG/
MedVLThinker/

# Nested git dirs (belt-and-suspenders)
**/.git/

# Results, checkpoints, logs — regenerable, not source
ckpts/
logs/
# results/ is ignored EXCEPT the prose + numeric evidence under results/cascade_methods/,
# which is the provenance for every number the project reports (~5 MB of .md + .json).
# NOTE: we ignore the *contents* (results/*) rather than the directory (results/), because
# git never descends into an excluded directory, so a `!` negation inside one never applies.
results/*
!results/cascade_methods/
results/cascade_methods/*
!results/cascade_methods/docs/
!results/cascade_methods/artifacts/
!results/cascade_methods/README.md
!results/cascade_methods/METHOD_IDEAS_BACKLOG.md
data/

# Archived experiment data (killed directions; kept on disk, not in git)
archive/single-model-routing/gate_7b_rag_axes/

# Local data / weights / corpora (never commit large or licensed data)
*.parquet
*.npz
*.csv
*.bin
*.pt
*.pth
*.safetensors

# Env / scratch
env_backup_*.txt
wrote
.ipynb_checkpoints/
**/__pycache__/
*.pyc
.venv/
venv/
MedEvalKit/

# graphify generated code-graph artifacts (regenerate with: graphify update ./src)
graphify-out/

# LaTeX toolchain: locally-installed tectonic binary (55MB) + its lib symlink.
# Reinstall with: curl --proto '=https' --tlsv1.2 -fsSL https://drop-sh.fullyjustified.net | sh
tools/
# tectonic/latex build artifacts
paper/*.aux
paper/*.log
paper/*.out

# hidden-state feature cache for the discriminative-verifier experiment (2.2 GB, regenerable
# via src/training_methods/extract_generator_hidden.py)
feats_hidden/
