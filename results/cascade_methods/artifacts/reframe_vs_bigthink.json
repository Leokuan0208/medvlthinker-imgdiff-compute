{
 "_meta": {
  "title": "Reframe: regime-adaptive allocator (ACC 3-tier + format router) vs always-32B-THINK baseline",
  "date": "2026-07-07",
  "framing": "Baseline = always-32B-THINK ('use the big thinking model for everything'). Method = REGIME-ADAPTIVE 3-tier allocator: MCQ -> ACC (7B-nt -> 32B-nt -> 32B-think, gated so slow think fires only on the reasoning residual); open-text -> 7B best-of-N + trained verifier. Think helps ONLY on reasoning (MMMU/MedXpert); on perception no-think >= think, so think ~never fires.",
  "no_fabrication": "Every number copied from master_data.csv (measured batch-1 latency/energy), MedEvalKit eval_results_*_reason total_results.json, or the cited doc/artifact. CPU analysis only; no new GPU runs.",
  "harness_note": "TWO eval contexts, kept separate: (1) the 5-family ACC MCQ bake-off (master_data.csv, NGC harness) carries the MEASURED batch-1 latency/energy and the pooled efficiency; (2) the faithful 3-family MedEvalKit eval (eval_results_*) carries the reasoning-regime think deltas. Do not cross-multiply accuracies between harnesses.",
  "method_row": "Ours (ACC-v2: agreement) = the canonical deployed method row in master_data.csv"
 },
